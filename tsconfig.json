{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "tests/**/*", "**/*.test.ts", "**/*.test.tsx", "playwright.config.ts", "src/lib/monitoring.ts", "src/lib/performance-testing.ts", "src/lib/exporters/**", "src/hooks/useMockData.ts", "src/lib/mock-mode.ts", "src/lib/query-cache.ts", "src/lib/security-audit.ts", "src/services/ExportScheduler.ts", "src/components/HabitTrackerMode.tsx", "src/app/api/monitoring/**", "src/middleware.ts"]
}